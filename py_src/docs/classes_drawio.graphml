      <data key="d2">class</data>
    </node>
    <edge id="e_RandomSampler_Sampler" source="RandomSampler" target="Sampler">
      <data key="d3">inherits</data>
    </edge>
    
    <node id="StratifiedSampler" labels="StratifiedSampler">
