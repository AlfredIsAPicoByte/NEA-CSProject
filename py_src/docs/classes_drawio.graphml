<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d0" for="node" attr.name="description" attr.type="string"/>
  <key id="d1" for="node" attr.name="module" attr.type="string"/>
  <key id="d2" for="node" attr.name="type" attr.type="string"/>
  <key id="d3" for="edge" attr.name="relationship" attr.type="string"/>
  
  <graph id="NEA-CSProject" edgedefault="directed">
    <attr name="name">NEA-CSProject Class Hierarchy</attr>
    <attr name="description">Class hierarchy and inheritance relationships for NEA-CSProject Ray Tracing Engine</attr>
    
    <!-- ===== DATA MODULE ===== -->
    <node id="Camera" labels="Camera">
      <data key="d0">Virtual camera with projection and ray generation</data>
      <data key="d1">Data</data>
      <data key="d2">class</data>
    </node>
    <node id="CameraType" labels="CameraType">
      <data key="d0">Enum: PERSPECTIVE, ORTHOGRAPHIC</data>
      <data key="d1">Data</data>
      <data key="d2">enum</data>
    </node>
    <node id="CameraMode" labels="CameraMode">
      <data key="d0">Enum: FIRST_PERSON, PLANE, ORBIT</data>
      <data key="d1">Data</data>
      <data key="d2">enum</data>
    </node>
    
    <node id="Color" labels="Color">
      <data key="d0">RGBA color with float values [0.0, 1.0]</data>
      <data key="d1">Data</data>
      <data key="d2">class</data>
    </node>
    <node id="ColorGradient" labels="ColorGradient">
      <data key="d0">Gradient for color interpolation</data>
      <data key="d1">Data</data>
      <data key="d2">class</data>
    </node>
    
    <node id="Transform" labels="Transform">
      <data key="d0">3D transformation (position, rotation, scale)</data>
      <data key="d1">Data</data>
      <data key="d2">class</data>
    </node>
    
    <node id="Ray" labels="Ray">
      <data key="d0">Ray in 3D space with origin and direction</data>
      <data key="d1">Data</data>
      <data key="d2">class</data>
    </node>
    <node id="TracingRay" labels="TracingRay">
      <data key="d0">Ray with path tracing state</data>
      <data key="d1">Data</data>
      <data key="d2">class</data>
    </node>
    <edge id="e_TracingRay_Ray" source="TracingRay" target="Ray">
      <data key="d3">inherits</data>
    </edge>
    
    <node id="RayPool" labels="RayPool">
      <data key="d0">Object pool for efficient ray reuse</data>
      <data key="d1">Data</data>
      <data key="d2">class</data>
    </node>
    
    <node id="HitInfo" labels="HitInfo">
      <data key="d0">Ray-object intersection information</data>
      <data key="d1">Data</data>
      <data key="d2">class</data>
    </node>
    
    <node id="Ratio" labels="Ratio">
      <data key="d0">Mathematical ratio (numerator/denominator)</data>
      <data key="d1">Data</data>
      <data key="d2">class</data>
    </node>
    
    <node id="Sampler" labels="Sampler">
      <data key="d0">Abstract base for sampling strategies</data>
      <data key="d1">Data</data>
      <data key="d2">abstract</data>
    </node>
    <node id="RandomSampler" labels="RandomSampler">
